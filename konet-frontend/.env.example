# Server-only backend address. Use the deployed HTTPS API for teammates without Docker.
KONET_API_URL=http://localhost:4000/api/v1
# Frontend npm run dev automatically uses localStorage access tokens.
# Frontend npm run build/start uses HttpOnly cookie authentication.

# Optional server-only overrides for a reverse proxy. Defaults to KONET_API_URL origin + /chat.
KONET_SOCKET_URL=
KONET_SOCKET_PATH=
