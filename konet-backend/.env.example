NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://konet:konet@localhost:5432/konet
DIRECT_URL=postgresql://konet:konet@localhost:5432/konet
JWT_ACCESS_SECRET=local-development-access-secret-change-before-production-0001
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production-0002
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
STORAGE_LOCAL_PATH=./uploads
SWAGGER_ENABLED=true
TRUST_PROXY=true
SERVICE_NAME=konet-api
SHUTDOWN_TIMEOUT_MS=10000

# Configure all three together to enable password recovery and the durable email worker.
# RESEND_API_KEY=re_replace_with_sending_key
# EMAIL_FROM=support@your-verified-domain.example
# EMAIL_OUTBOX_KEY=replace_with_64_hex_characters_from_openssl_rand_hex_32
# PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Cloudinary storage for private evidence and signed profile picture uploads.
# All three credentials are required together; the API secret stays server-side.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# EVIDENCE_RETENTION_DAYS=30

# Paystack hosted checkout: configure a test key before sandbox testing.
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=

# Enable only when Paystack merchant transfers and reserve funding are configured.
PAYSTACK_TRANSFERS_ENABLED=false

# Monitored recipient for public contact-form submissions.
SUPPORT_EMAIL=

# Comma-separated frontend origins allowed for REST and Socket.IO. Add deployed frontend here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 32-byte encryption key encoded as 64 hex characters. Required for staff MFA.
STAFF_MFA_ENCRYPTION_KEY=
# Production always requires MFA; disable only for isolated development/testing.
STAFF_MFA_REQUIRED=false

